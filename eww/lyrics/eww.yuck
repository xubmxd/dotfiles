(deflisten lyrics_data "../scripts/lyrics.py")

(defwindow mewsic_lyrics
    :monitor 0
    :geometry (geometry :x "0px"
                        :y "160px"
                        :width "500px"
                        :height "40px"
                        :anchor "bottom center")
    :stacking "bg"
    :exclusive false
    (lyrics_widget))

(defwidget lyrics_widget []
    (box :class "lyrics-wrapper"
         :orientation "v"
         :valign "center"
         :halign "center"
        (box :class "lyrics-container"
             :orientation "v"
             :valign "center"
             :halign "center"
            (label :class "lyrics-text"
                   :text "${lyrics_data.text}"
                   :wrap true
                   :justify "center"))))
