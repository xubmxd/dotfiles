(include "./lyrics.yuck")


;; ─────────────────────────────────────────────────────────────────────────────
;; CAVA DATA
;; ─────────────────────────────────────────────────────────────────────────────

(deflisten cava_json
  :initial "[]"
  "bash ~/.config/eww/visualizer/run_cava.sh")


;; ─────────────────────────────────────────────────────────────────────────────
;; CAVA VISUALIZER
;; ─────────────────────────────────────────────────────────────────────────────

(defwidget cava_widget []
  (box
    :class "cava-container"
    :orientation "h"
    :space-evenly false
    :spacing 0
    :hexpand true
    :vexpand true
    :halign "fill"
    :valign "fill"

    (for val in cava_json
      (box
        :class "cava-bar"
        :hexpand true
        :valign "end"
        :style "min-height: ${val}px;"
      )
    )
  )
)


;; ─────────────────────────────────────────────────────────────────────────────
;; CAVA WINDOW
;; ─────────────────────────────────────────────────────────────────────────────

(defwindow cava_visualizer

  :monitor 0

  ;; Keep Cava behind normal application windows.
  :stacking "bg"

  ;; Cava does not reserve screen space.
    :exclusive "ignore"

  :namespace "cava-visualizer"

    :geometry (geometry
      :x "0px"
      :y "0px"
      :width "100%"
      :height "150px"
      :anchor "bottom left")

  (cava_widget)
)
