;; Listen to the bash script output continuously
(deflisten cava_json :initial "[]"
  "bash ~/.config/eww/visualizer/run_cava.sh")

(defwidget cava_widget []
  (box :class "cava-container" 
       :orientation "h" 
       :space-evenly true 
       :spacing 4 
       :valign "end"
    
    (for val in cava_json
      (box :class "cava-bar" 
           :valign "end" 
           ;; FIXED: GTK requires min-height instead of height
           :style "min-height: ${val}px;")
    )
  )
)

(defwindow cava_visualizer
  :monitor 0
  :stacking "bg"
  :exclusive false
  :namespace "cava-visualizer"
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "150px"
                      :anchor "bottom center")
  (cava_widget))
