(deflisten lyrics_data "../scripts/lyrics.py")

(defwindow mewsic_lyrics
    :monitor 0
    :geometry (geometry :x "20px"
                        :y "20px"
                        :width "400px"
                        :height "600px"
                        :anchor "top right")
    :stacking "bg"
    :exclusive false
    (lyrics_widget))

(defwidget lyrics_widget []
    (box :class "lyrics-container"
         :orientation "v"
         :space-evenly false
        (scroll :vscroll true
                :hscroll false
                :class "lyrics-scroll"
            (label :class "lyrics-text"
                   :text "${lyrics_data.text}"
                   :wrap true
                   :valign "start"
                   :halign "center"))))
