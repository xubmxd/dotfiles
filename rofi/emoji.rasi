@import "~/.cache/wal/colors.rasi"

configuration {
    /* Changed modi to 'emoji' */
    modi: "emoji";
    show-icons: false; /* Emojis are text characters, not icons */

    display-emoji: "Emoji";

    matching: "normal";
    sorting-method: "normal";

    cycle: true;
    hover-select: false;
    disable-history: false;
}

* {
    font: "JetBrainsMono Nerd Font 13";

    /* Dynamic Colors from Pywal */
    fg:             @foreground;
    
    /* Safely formatted universal dark overlay */
    bg:             rgba(0, 0, 0, 0.5); 
    bg-alt:         rgba(255, 255, 255, 0.08); 

    /* Mapping Pywal's color palette */
    accent:         @color4;    
    accent-alt:     @color5;    

    text-color:     @fg;
    background-color: transparent;
}

window {
    /* Made the window slightly narrower for a tighter emoji grid */
    width: 550px; 
    
    background-color: @bg;

    border: 2px;
    border-color: @accent;

    border-radius: 24px;
    padding: 30px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 24px;
}

inputbar {
    background-color: @bg-alt;

    border-radius: 18px;
    padding: 14px;

    children: [ prompt, entry ];
}

prompt {
    background-color: @accent;
    
    /* Dark text for sharp contrast */
    text-color: @background; 

    border-radius: 12px;
    padding: 10px 18px;
    expand: false;

    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    expand: true;
    background-color: transparent;
    text-color: @fg;

    placeholder: "Search emojis...";
    placeholder-color: @color8;

    padding: 10px;
    font: "JetBrainsMono Nerd Font 13";
}

listview {
    /* Transformed into a grid layout! */
    columns: 6; 
    lines: 4;

    spacing: 12px;

    dynamic: true;
    fixed-height: false; /* Allows the window to shrink */
    cycle: true;

    scrollbar: false;
    layout: vertical;
}

element {
    /* Stacked vertically to center the emoji */
    orientation: vertical; 

    padding: 12px 0px;
    border-radius: 14px;
    background-color: transparent;

    border: 2px;
    border-color: transparent;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.5;

    text-color: @fg;

    font: "JetBrainsMono Nerd Font 15, icomoon 15"; 
}

/* Explicitly defined base states to prevent default theme bleed-through */
element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg-alt;
    border-color: @accent;
}

element selected.active {
    background-color: @bg-alt;
    border-color: @accent-alt;
}

/* Removed element-icon since emojis render as text */
