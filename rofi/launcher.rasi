@import "~/.cache/wal/colors-rofi-dark.rasi"

configuration {
    show-icons: true;
    display-drun: "    ";
    display-run: "    > ";
    drun-display-format: "{name}";
    font: "Inter 11";
    modi: "drun,run,window";
    show-match: false;
    sidebar-mode: false;
}

* {
    background: transparent;

    bg: rgba(0, 0, 0, 0.48);
    bg-search: rgba(0, 0, 0, 0.58);
    bg-row: rgba(0, 0, 0, 0.20);
    bg-selected: rgba(255, 255, 255, 0.16);

    fg: @foreground;
    fg-dim: rgba(255, 255, 255, 0.55);

    border: 0px;
    border-color: transparent;

    margin: 0px;
    padding: 0px;
    spacing: 0px;

    radius: 8px;

    text-color: @fg;
}

window {
    background-color: transparent;
    border: 0px;

    location: center;
    anchor: center;

    width: 480px;
    padding: 4px;
}

mainbox {
    background-color: transparent;
    border: 0px;

    padding: 0px;
    spacing: 4px;
}

inputbar {
    background-color: @bg-search;
    border: 0px;
    border-radius: @radius;
    padding: 8px 12px;
    margin: 0px;
    spacing: 0px;

    children: [ textbox-prompt-colon, entry, case-indicator ];
}

textbox-prompt-colon {
    background-color: transparent;
    text-color: @fg;
    str: "";
    font: "JetBrainsMono Nerd Font 12";
    padding: 0px 8px 0px 0px;
    margin: 0px;
}

prompt {
    background-color: transparent;

    text-color: @fg-dim;
    font: "Inter 11";

    padding: 0px;
    margin: 0px;
}

entry {
    background-color: transparent;

    text-color: @fg;
    placeholder-color: @fg-dim;
    font: "Inter 11";

    border: 0px;

    padding: 0px;
    margin: 0px;
}

case-indicator {
    background-color: transparent;

    text-color: @fg-dim;

    padding: 0px;
    margin: 0px;
}

listview {
    background-color: @bg;

    border: 0px;
    border-radius: @radius;

    padding: 4px;

    lines: 8;
    columns: 1;

    fixed-height: false;

    scrollbar: false;
}

element {
    background-color: @bg-row;

    text-color: @fg;

    padding: 6px 10px;
    margin: 1px 0px;

    border-radius: 5px;

    orientation: horizontal;
}

element normal {
    background-color: @bg-row;
}

element normal.normal {
    background-color: @bg-row;
    text-color: @fg;
}

element normal.urgent {
    background-color: @bg-row;
}

element normal.active {
    background-color: @bg-row;
}

element selected {
    background-color: @bg-selected;
}

element selected.normal {
    background-color: @bg-selected;
    text-color: @fg;
}

element selected.urgent {
    background-color: @bg-selected;
}

element selected.active {
    background-color: @bg-selected;
}

element alternate {
    background-color: @bg-row;
}

element alternate.normal {
    background-color: @bg-row;
    text-color: @fg;
}

element alternate.urgent {
    background-color: @bg-row;
}

element alternate.active {
    background-color: @bg-row;
}

element-text {
    background-color: transparent;

    text-color: @fg;
    font: "Inter 11";

    vertical-align: 0.5;
    horizontal-align: 0.0;
}

element-icon {
    background-color: transparent;

    size: 24px;

    padding: 0px 8px 0px 0px;
}

element-icon selected {
    background-color: transparent;
}

scrollbar {
    background-color: transparent;

    handle-width: 4px;
    handle-color: rgba(255, 255, 255, 0.25);

    border: 0px;

    padding: 0px;
    margin: 0px;
}

error-message {
    background-color: transparent;
    text-color: @urgent-background;
}

mode-switcher {
    enabled: false;
}

button {
    enabled: false;
}
